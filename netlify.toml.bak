# Netlify 部署配置
#
# 为什么换到 Netlify：Cloudflare 的 *.workers.dev / *.pages.dev 在这边被解析到 127.0.0.1，
# 打不开；而 *.netlify.app 实测 443 可通，且免费额度自带 Node 函数（能跑 /api/*），
# 所以「官方渠道 → 联网 → 模型」这条链路可以原样保留，不需要买域名。
#
# 注意：不要加 /* → /index.html 的兜底重写，否则会把 /api/* 的函数路由一起吞掉。
# 这个作品只有一页，站内跳转都是 #锚点，不需要 SPA 重写。

[build]
  # 这里不再跑构建：产物先在本机 `SPLIT=1 node tools/build.mjs` 生成 dist，
  # 再由 `node tools/pack-site.mjs` 整理成提交进仓库的 site/ 目录。
  # 原因：Netlify 侧的构建从 2026-11-12 20:48 起连续失败（同一份代码在本机 clean clone
  # 能构建成功），日志又需要登录才能看；发布预构建目录可以跳过这一步，先保证线上是最新版本。
  command = "echo prebuilt site"
  publish = "site"

[functions]
  directory = "netlify/functions"
  node_bundler = "esbuild"
  # functions 会 import 仓库根的 lib/core.js（与本地 server.mjs 共用同一套检索逻辑）
  included_files = ["lib/core.js"]

[build.environment]
  NODE_VERSION = "22"
